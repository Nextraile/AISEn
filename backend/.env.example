# Backend configuration.
#
# Copy this file to `.env` (git-ignored) and fill it in. Only the Gemini values
# are needed: everything else defaults to the values below, so an empty file
# behaves exactly like the measured defaults.
#
# The same file is read by `uvicorn ... --env-file .env` and by Docker Compose
# through `env_file: .env`. Run commands from `backend/`, because relative paths
# below resolve against that directory.

# ---- LLM (optional) ---------------------------------------------------------
# Without both values the API still works and returns the list only
# (`status: "list_only"`, `llm_configured: false` in /health).
GEMINI_API_KEY=
GEMINI_MODEL=

# ---- Search -----------------------------------------------------------------
# Embedding model. Must match the model the collection was built with;
# `ingest.py` records it in the collection metadata and the API warns at startup
# when they differ. Changing it requires `python ingest.py --index`.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ChromaDB persistent directory (relative to backend/).
CHROMA_DB_PATH=./data/vector_db

# Collection name inside that directory.
CHROMA_COLLECTION=undip_research_search

# Candidates fetched per query before filtering in Python. There is no
# pagination, so this caps the maximum number of results.
SEARCH_N_RESULTS=100

# Threshold: minimum similarity (1 - cosine distance), higher = stricter.
# Must satisfy 0 <= MIN < DEFAULT < MAX <= 1, or startup fails.
# 0.53 is measured on the 1,000-record sample: relevant phrases 0.58-0.73,
# off-topic <= 0.46. See README, "Why the default is 0.53".
THRESHOLD_MIN=0.1
THRESHOLD_MAX=0.9
THRESHOLD_DEFAULT=0.53

# ---- Summary ----------------------------------------------------------------
# Top results handed to the LLM. Must be <= SEARCH_N_RESULTS.
SUMMARY_TOP_K=5

# Seconds to wait for Gemini. Real calls take 1-7 s with a tail past 8 s.
LLM_TIMEOUT_SECONDS=15

# ---- HTTP -------------------------------------------------------------------
# Comma-separated allowed origins. `*` is the prototype default; set the real
# frontend origin before publishing, e.g. https://aisen.example.com
CORS_ALLOW_ORIGINS=*

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ---- Ingestion (ingest.py) --------------------------------------------------
# CLI flags still win over these values.
OAI_ENDPOINT=https://eprints2.undip.ac.id/cgi/oai2
INGEST_TARGET=1000
INGEST_JSON_PATH=data/documents.json

# Records inserted per ChromaDB batch. ChromaDB rejects batches above ~5,461.
INSERT_BATCH_SIZE=1000

# Documents per embedding batch. Lower it on a low-memory machine.
EMBED_BATCH_SIZE=64

# Harvest filter: abstracts at or below this length are skipped.
MIN_DESCRIPTION_CHARS=50

# ---- Docker (compose) -------------------------------------------------------
# Host port for the API and how long the healthcheck tolerates model loading.
# APP_UID must match your host UID so the bind-mounted DB is writable.
# API_PORT=8000
# HEALTH_START_PERIOD=120s
# APP_UID=1000
