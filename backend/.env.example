# The same file is read by `uvicorn ... --env-file .env` and by Docker Compose through `env_file: .env`
# Run commands from `backend/`, because relative paths below resolve against that directory

GEMINI_API_KEY=
GEMINI_MODEL=

# Must match the model the collection was built with
# `ingestion/ingest.py` records it in the collection metadata; the API warns if they differ
# Changing it requires `python -m ingestion.ingest --index`
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

CHROMA_DB_PATH=./data/vector_db
CHROMA_COLLECTION=undip_research_search

# Candidates fetched per query before filtering in Python
# No pagination, this caps the maximum number of results
SEARCH_N_RESULTS=100

# Threshold: minimum similarity (1 - cosine distance), higher = stricte
# Must satisfy 0 <= MIN < DEFAULT < MAX <= 1, or startup fails
# 0.60 is measured on the full 47,993-record corpus: relevant phrases 0.74-0.84,
# off-topic noise <= 0.559. At the old 0.53 food-adjacent noise leaked through
# ("resep rendang padang" -> a mochi paper at 0.538). Re-measure if the corpus changes.
THRESHOLD_MIN=0.1
THRESHOLD_MAX=0.9
THRESHOLD_DEFAULT=0.60

SUMMARY_TOP_K=5 # Top results handed to the LLM. Must be <= SEARCH_N_RESULTS
LLM_TIMEOUT_SECONDS=15 # Seconds to wait for Gemini. Real calls take 1-7 s with a tail past 8 s

CORS_ALLOW_ORIGINS=*

LOG_LEVEL=INFO # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=text # text | json (one JSON object per line, for a collector)
LOG_FILE=logs/aisen.log # also append to this file, e.g. logs/aisen.log (directory is created)

# Ingestion
# CLI flags still win over these values.
# Re-running a stage resumes it; `--fresh` is the only way to start over.
OAI_ENDPOINT=https://eprints2.undip.ac.id/cgi/oai2
INGEST_TARGET=1000
INGEST_JSON_PATH=data/documents.json

INSERT_BATCH_SIZE=1000 # Records inserted per ChromaDB batch. ChromaDB rejects batches above ~5,461
EMBED_BATCH_SIZE=64 # Documents per embedding batch. Lower it on a low-memory machine
MIN_DESCRIPTION_CHARS=50 # Harvest filter: abstracts at or below this length are skipped

# Resume state for the harvesting and indexing stages: the harvest journal,
# its page cursor, and the single-writer lock. Disposable by definition --
# deleting it only costs rework, and `--fresh` does exactly that.
TEMP_DIR=data/temp

# How often the long stages report progress. Higher = quieter log. A silent run
# is indistinguishable from a hung one, so keep one line per few minutes at most.
PROGRESS_EVERY=250 # Log a harvest line every N valid records (--progress-every overrides)
EMBED_CHUNK_SIZE=5000 # Encode and log in chunks of N documents (--embed-chunk-size overrides)

# Docke
# Host port for the API and how long the healthcheck tolerates model loading
# APP_UID must match your host UID so the bind-mounted DB is writable
API_PORT=8000
HEALTH_START_PERIOD=120s
APP_UID=1000

# `watch` service: polls /ready and logs state changes
# Set ALERT_WEBHOOK_URL to a Discord/generic webhook to also be notified
WATCH_INTERVAL_SECONDS=30
WATCH_TIMEOUT_SECONDS=5
ALERT_WEBHOOK_URL=
