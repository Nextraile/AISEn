# Frontend configuration.
#
# Copy the values you want to change into `.env` (already committed with local
# defaults) or pass them to the build. Vite inlines every VITE_* value at build
# time, so changing one requires a rebuild, not just a restart.
#
# The fallbacks in src/app/config.ts are identical to the values below.

# Base URL of the FastAPI backend, no trailing slash.
VITE_API_BASE_URL=http://localhost:8000

# Request timeout in milliseconds. Keep it above the backend's LLM budget
# (LLM_TIMEOUT_SECONDS, default 15 s), otherwise slow summaries abort here.
VITE_API_TIMEOUT_MS=15000

# Minimum similarity sent when a caller omits the threshold. Should match the
# backend's THRESHOLD_DEFAULT (0.53), otherwise the two disagree silently.
VITE_DEFAULT_THRESHOLD=0.53

# Results shown per page.
VITE_RESULTS_PER_PAGE=10

# Delay before a slider change triggers a new request.
VITE_SEARCH_DEBOUNCE_MS=350

# The three relevance buttons. Must stay within the backend's
# THRESHOLD_MIN..THRESHOLD_MAX (default 0.1..0.9) and be ordered low <= medium
# <= high; out-of-range values are clamped with a console warning.
VITE_RELEVANCE_LOW=0.4
VITE_RELEVANCE_MEDIUM=0.5
VITE_RELEVANCE_HIGH=0.6
