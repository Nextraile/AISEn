FROM node:22-alpine AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

ARG VITE_API_BASE_URL=/api
ARG VITE_API_TIMEOUT_MS=15000
ARG VITE_DEFAULT_THRESHOLD=0.53
ARG VITE_RESULTS_PER_PAGE=10
ARG VITE_SEARCH_DEBOUNCE_MS=350
ARG VITE_RELEVANCE_LOW=0.4
ARG VITE_RELEVANCE_MEDIUM=0.5
ARG VITE_RELEVANCE_HIGH=0.6

ENV VITE_API_BASE_URL=$VITE_API_BASE_URL \
    VITE_API_TIMEOUT_MS=$VITE_API_TIMEOUT_MS \
    VITE_DEFAULT_THRESHOLD=$VITE_DEFAULT_THRESHOLD \
    VITE_RESULTS_PER_PAGE=$VITE_RESULTS_PER_PAGE \
    VITE_SEARCH_DEBOUNCE_MS=$VITE_SEARCH_DEBOUNCE_MS \
    VITE_RELEVANCE_LOW=$VITE_RELEVANCE_LOW \
    VITE_RELEVANCE_MEDIUM=$VITE_RELEVANCE_MEDIUM \
    VITE_RELEVANCE_HIGH=$VITE_RELEVANCE_HIGH

COPY . .
RUN npm run build

COPY nginx.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 8080
