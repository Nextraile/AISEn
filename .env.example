# Salin file ini menjadi .env lalu isi nilainya:
#   cp .env.example .env
#
# .env di-load otomatis oleh binary (main.go -> cli.LoadDotEnv)
# dan oleh Docker Compose (dari root proyek).

# Qdrant (opsional; default http://127.0.0.1:6333)
# QDRANT_URL=http://127.0.0.1:6333
# QDRANT_API_KEY=

# ONNX Runtime shared library (opsional; default lib/libonnxruntime.so)
# ONNXRUNTIME_SHARED_LIBRARY_PATH=/path/ke/libonnxruntime.so

# Ringkasan AI via Gemini (untuk perintah search -summarize)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
